{
	"info": {
		"_postman_id": "astrovedham-customer-api-v1",
		"name": "AstroVedham Customer App APIs",
		"description": "Complete collection of AstroVedham Customer APIs for Mobile App Developers (Flutter / React Native / Android / iOS). Includes Authentication, Plan Types, Pricing, Cashfree Buy Now & Verify, Horoscope Generation for all 10 types, and Order History.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5002/api",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"9876543210\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/customer/send_otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"customer",
								"send_otp"
							]
						},
						"description": "Send 6-digit OTP to user mobile."
					},
					"response": []
				},
				{
					"name": "1.2 Verify OTP & Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('auth_token', jsonData.data.token);",
									"    console.log('auth_token saved:', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/customer/verify_otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"customer",
								"verify_otp"
							]
						},
						"description": "Verify OTP and obtain JWT bearer token. (Use 123456 as master test OTP in dev)."
					},
					"response": []
				},
				{
					"name": "1.3 Get Profile",
